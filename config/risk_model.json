  "drift": {
    "window_days": 7,
    "priority_points": {"CRITICAL": 40, "HIGH": 25, "MEDIUM": 10, "LOW": 5, "INFO": 0},
    "ignore_categories": ["BASELINE", "CORRECTED", "EVIDENCE_RESTORED"]
  },
  "criticality": {"Low": 25, "Medium": 50, "High": 75, "Critical": 100},
  "bands": {"Low": 0, "Medium": 25, "High": 50, "Critical": 75},
