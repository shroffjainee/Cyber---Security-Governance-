  "compliance": {
    "check_weights": {
      "SSH-001": 1.0, "SSH-002": 0.9, "FW-001": 1.0, "SVC-001": 0.6,
      "FILE-001": 0.9, "PWD-001": 0.5, "LOCK-001": 0.5, "UPD-001": 0.8
    },
    "status_risk": {"COMPLIANT": 0.0, "NON_COMPLIANT": 1.0, "UNKNOWN": 0.5, "ERROR": 0.5},
    "max_undetermined_fraction": 0.5
