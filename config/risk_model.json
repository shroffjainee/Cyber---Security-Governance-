{
  "_comment": "Prototype risk-priority model. Scores are 0-100 PRIORITY indicators, not validated probabilities of exploitation or loss. Change model_version whenever weights or rules change; risk drift is only computed between scores of the same model_version.",
  "model_version": "rdf-risk-1.0",
  "weights": {"V": 0.45, "C": 0.25, "D": 0.20, "A": 0.10},
  "alternative_weight_sets": {
    "equal":            {"V": 0.25, "C": 0.25, "D": 0.25, "A": 0.25},
    "vulnerability_heavy": {"V": 0.60, "C": 0.20, "D": 0.10, "A": 0.10},
    "compliance_heavy": {"V": 0.30, "C": 0.40, "D": 0.20, "A": 0.10},
    "drift_heavy":      {"V": 0.35, "C": 0.20, "D": 0.35, "A": 0.10}
  },
  "vulnerability": {
    "max_component_share": 0.7,
    "breadth_share": 0.3,
    "breadth_saturation": 10.0,
    "min_cvss_counted": 0.1,
    "label_fallback_cvss": {"critical": 9.5, "high": 8.0, "medium": 5.5, "low": 2.5, "log": 0.0},
    "unknown_cvss_default": 5.0,
    "max_scan_age_days": 30,
    "min_qod": 30
